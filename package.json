{
  "name": "plainkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project=fast --trace off && playwright test --project=models --workers=1 --trace off",
    "copy-ort": "node scripts/copy-ort.mjs",
    "predev": "node scripts/copy-ort.mjs && node scripts/copy-transcribe.mjs && node scripts/copy-heif.mjs",
    "prebuild": "node scripts/copy-ort.mjs && node scripts/copy-transcribe.mjs && node scripts/copy-heif.mjs",
    "copy-transcribe": "node scripts/copy-transcribe.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@mediabunny/aac-encoder": "^1.66.0",
    "@mediabunny/flac-encoder": "^1.66.0",
    "@mediabunny/mp3-encoder": "^1.66.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "cronstrue": "^3.39.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "exifr": "^7.1.3",
    "fflate": "0.8.2",
    "gifenc": "^1.0.3",
    "gifuct-js": "2.1.2",
    "jsqr": "^1.4.0",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.72.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "mediabunny": "^1.65.2",
    "onnxruntime-web": "^1.31.1",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
